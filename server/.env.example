# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/job_portal?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/job_portal?retryWrites=true&w=majority

# JWT Authentication (Required in production)
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL (Used for CORS whitelist and password reset links)
CLIENT_URL=http://localhost:5173

# Local Development Fallback: Set to true to allow in-memory MongoDB for offline local testing
ALLOW_IN_MEMORY_DB=true

# SMTP Email Configuration (Required in production for Forgot Password emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@jobportal.example.com
