# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/job_portal?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/job_portal?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL (For CORS whitelist in production and development)
CLIENT_URL=http://localhost:5173

# Local Development Fallback: Set to true to allow in-memory MongoDB for offline local testing
ALLOW_IN_MEMORY_DB=true
